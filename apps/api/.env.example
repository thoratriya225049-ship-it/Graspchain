# ───────────────────────────────────────────────────────────────────────────────
# Graspchain API configuration. Copy to apps/api/.env (or run `pnpm run setup:env`, which
# does it and generates the three secrets). Validated with zod at boot: a missing
# or invalid value stops the API and names the variable.
# Never commit .env. Never put real keys in this file.
# ───────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# CORS allowlist (the web app's origin) and public URLs used in receipts/QR codes.
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
VERIFIER_URL=http://localhost:5174/
LOG_LEVEL=info

# ── Data ────────────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/graspchain.db

# ── Secrets (required, ≥ 16 characters each; `pnpm run setup:env` generates them) ───────
COOKIE_SECRET=
QUEUE_SECRET=
ADMIN_SECRET=
# Admin demo tools (tamper, mode switches). 1 only on a demo machine; must be 0 in production.
ADMIN_DEMO_TOOLS=0
# off | replay   (replay serves cached Jev/LLM answers only and never calls the network)
DEMO_MODE=off

# ── Stage 2 judge ───────────────────────────────────────────────────────────────
# evidence = Graspchain Evidence Judge (default). The LLM below (e.g. Groq) only EXTRACTS
#            evidence — claim/article relations with word-for-word quotes. Code validates every
#            quote against the article and applies published rules to classify key points
#            (UNDERSTOOD / PARTIALLY_UNDERSTOOD / MISUNDERSTOOD / MISSED, claims UNSUPPORTED) and
#            compute the 1–10 score. The LLM never outputs a score. Needs LLM_PROVIDER/LLM_MODEL/key.
# jev      = Jev via the official @typesafe-ai/sdk (needs JEV_API_KEY)
# local    = the local demo judge (deterministic rubric matcher). It is NOT Jev: every
#            receipt records models.jev = "local-rubric-judge@1" and the UI labels it.
JUDGE=evidence
# Evidence extraction model (defaults to LLM_MODEL) and its hard timeout. On timeout or an
# unusable extraction the attempt is marked delayed and retried — nothing is invented.
EVIDENCE_MODEL=
EVIDENCE_TIMEOUT_MS=30000
# Route A (TypeSafe direct): https://api.typesafe.ai            model jev-1.13.0
# Route B (Vercel AI Gateway): https://ai-gateway.vercel.sh/typesafe   model typesafe-ai/jev
# Route C (OpenRouter): https://openrouter.ai/api               model typesafe/jev-1.13
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_DAILY_TOKEN_CAP=2000000
# on = evaluate choice questions in both option orders and average (order-bias debias, E3)
JEV_ORDER_DEBIAS=off
JEV_TIMEOUT_MS=8000

# ── LLM (claim segmentation + feedback) ─────────────────────────────────────────
# google | groq | none. With no model/key the pipeline uses its documented fallbacks:
# sentence-split segmentation and template feedback (both recorded per attempt).
# API keys live ONLY here (server side). The web app never receives them.
LLM_PROVIDER=groq
# Groq: openai/gpt-oss-120b supports strict structured outputs (used for evidence extraction).
LLM_MODEL=openai/gpt-oss-120b
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq keys start with gsk_ (console.groq.com/keys). Never commit a real key.
GROQ_API_KEY=
SEGMENT_TIMEOUT_MS=4000
FEEDBACK_TIMEOUT_MS=15000

# ── FairClock (reading time) ────────────────────────────────────────────────────
CLOCK_MODE=fair
FAIRCLOCK_CAP_S=10
# Optional: force every article's reading time (seconds), e.g. 30 for a quick demo.
READ_SECONDS_OVERRIDE=
WRITE_TTL_MIN=20
# A reading/writing session with no client heartbeat for this long expires and frees its FairGate slot.
SESSION_IDLE_S=120

# ── FairGate (fair entry) ───────────────────────────────────────────────────────
FAIR_MODE=fair
WINDOW_MS=2000
BURST_WINDOW_MS=5000
CONCURRENCY=3
TOKEN_TTL_S=30

# ── Chain (AssessmentRegistry) ──────────────────────────────────────────────────
# Local Hardhat node (pnpm chain:local) = 31337. Sepolia = 11155111.
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
# Sepolia: https://ethereum-sepolia-rpc.publicnode.com (no key); optional Alchemy backup.
CHAIN_RPC_BACKUP_URL=
# RPC the browser verifier should use (defaults: PublicNode on Sepolia, CHAIN_RPC_URL locally).
CHAIN_PUBLIC_RPC_URL=
# Defaults to https://sepolia.etherscan.io on Sepolia; empty locally.
CHAIN_EXPLORER_URL=
CHAIN_FROM_BLOCK=0
# Leave empty to read packages/contracts/deployments/<CHAIN_ID>.json (written by the deploy scripts).
REGISTRY_ADDRESS=
# The chain writer's key. On 31337, `pnpm run setup:env` fills in Hardhat's PUBLIC test key
# (account #0) — it is rejected on any other chain. On Sepolia use a fresh wallet
# that holds only faucet ETH.
DEPLOYER_PRIVATE_KEY=
MAX_FEE_GWEI=30

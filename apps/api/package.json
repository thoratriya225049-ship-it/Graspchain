{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Graspchain API: Fastify 5, SQLite (WAL), session + FairClock, FairGate, evaluator (LLM \u2192 Jev \u2192 fusion \u2192 LLM), trust layer and chain writer.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "order-flip": "tsx scripts/order-flip.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/groq": "4.0.59",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@graspchain/shared": "workspace:*",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "7.0.137",
    "better-sqlite3": "13.0.3",
    "ethers": "6.17.0",
    "fastify": "5.12.5",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "pino-pretty": "13.2.0",
    "vitest": "4.1.11"
  }
}

{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Graspchain web app (Next.js App Router): student, teacher, research and admin screens S1\u2013S12.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"web: unit logic lives in @graspchain/shared; run test:e2e for the browser suite\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@graspchain/shared": "workspace:*",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}

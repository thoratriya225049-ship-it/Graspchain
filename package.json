{
  "name": "graspchain",
  "private": true,
  "type": "module",
  "description": "Graspchain \u2014 proof-of-comprehension: timed reading, Jev + LLM assessment, fair entry and clock, receipts committed to Ethereum.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r build",
    "start": "tsx scripts/dev.ts --prod",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "migrate": "pnpm --filter api migrate",
    "seed": "pnpm --filter api seed",
    "backup": "pnpm --filter api backup",
    "chain:local": "pnpm --filter contracts node",
    "chain:deploy:local": "pnpm --filter contracts deploy:local",
    "chain:deploy:sepolia": "pnpm --filter contracts deploy:sepolia",
    "verifier:build": "pnpm --filter verifier build",
    "demo:smoke": "pnpm --filter api test:smoke",
    "fairness-sim": "tsx scripts/fairness-sim.ts",
    "tamper-test": "tsx scripts/tamper-test.ts",
    "benchmark": "pnpm --filter api run benchmark",
    "order-flip": "pnpm --filter api run order-flip",
    "fairclock-test": "pnpm --filter web exec playwright test e2e/fairclock.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "@next/eslint-plugin-next": "16.4.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
